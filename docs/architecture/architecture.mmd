    classDef aws fill:#eef3fa,stroke:#315f8c,color:#172b3d,stroke-width:2px;
    classDef future fill:#fff5df,stroke:#9b6816,color:#4a3512,stroke-width:2px,stroke-dasharray:6 4;
    class Client,Adapter,Stub implemented;
